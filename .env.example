VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
VITE_SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Set to "true" to register the /admin/*, /dev/storefront, and /showcase
# routes. Unset (default) strips them from the build entirely — direct
# navigation to any of those paths 404s. Admin auth is still mock/
# client-side even when enabled (see issue #297); this flag is a
# deployment-level compensating control, not real server-side enforcement.
VITE_ADMIN_ENABLED=
