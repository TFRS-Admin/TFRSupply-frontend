      "thenOption": "60in",
      "message": "Fire apparatus builds typically require the 60\" bar. Please confirm your length selection."
    },
    {
      "id": "dep-magnetic-controller",
      "type": "requires",
      "ifStep": "mounting",
      "ifOption": "magnetic",
      "thenStep": "controller",
      "thenOption": null,
