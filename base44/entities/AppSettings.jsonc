{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "logo_url": {
      "type": "string"
    },
    "logo_url_2": {
      "type": "string"
    },
    "logo_morph_enabled": {
      "type": "boolean",
      "default": true
    },
    "logo_morph_speed": {
      "type": "number",
      "default": 6
    },
    "logo_glitch_enabled": {
      "type": "boolean",
      "default": false
    },
    "logo_glitch_interval": {
      "type": "number",
      "default": 20
    },
    "logo_overlay_enabled": {
      "type": "boolean",
      "default": true
    },
    "back_to_top_logo": {
      "type": "string"
    },
    "logo_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "app_title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "title_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabled_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_banner": {
      "type": "string"
    },
    "banner_configs": {
      "type": "object"
    },
    "bottom_banner_url": {
      "type": "string"
    },
    "bottom_banner_link": {
      "type": "string"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "github": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "facebook": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      }
    },
    "donation_settings": {
      "type": "object",
      "properties": {
        "paypal_email": {
          "type": "string"
        },
        "stripe_link": {
          "type": "string"
        },
        "bitcoin_address": {
          "type": "string"
        },
        "buymeacoffee_username": {
          "type": "string"
        },
        "kofi_username": {
          "type": "string"
        },
        "patreon_url": {
          "type": "string"
        }
      }
    },
    "promo_bar": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "link_url": {
          "type": "string"
        },
        "link_text": {
          "type": "string"
        },
        "gradient": {
          "type": "string"
        },
        "shadow": {
          "type": "boolean"
        },
        "autoHide": {
          "type": "boolean"
        },
        "sticky": {
          "type": "boolean"
        }
      }
    },
    "modern_video": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "youtube_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "blockbuster_video": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "youtube_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "retro_tv": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "youtube_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "template_showcase": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "style": {
          "type": "string"
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "footer_config": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "number",
          "default": 4
        },
        "column_widgets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alignment": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      }
    }
  }
}